PORT=8000
WEB_CONCURRENCY=2
GUNICORN_CMD_ARGS=--timeout 180 --graceful-timeout 180 --keep-alive 5
WEB_REPLICAS=1
HOST=0.0.0.0
STACK_NAME=mystack
SWARM_MANAGER_HOSTNAME=clanker
IMAGE_REGISTRY=
IMAGE_REPOSITORY=lostfound
IMAGE_VERSION=
APP_IMAGE=
DOCKER_PLATFORM=linux/arm64
STACK_DEPLOY_WITH_REGISTRY_AUTH=1
POSTGRES_PASSWORD=lostfound-change-me
DATABASE_URL=
DATA_DIR=./data
DATABASE_PATH=./data/lost_found.db
UPLOAD_DIR=./uploads
UPLOAD_STORAGE_BACKEND=filesystem
UPLOAD_CACHE_DIR=/tmp/lostfound-uploads
LOG_DIR=./logs
LOG_TO_STDOUT=0
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=
EMAIL_VERIFICATION_SECRET=
EMAIL_VERIFICATION_CODE_TTL_SECONDS=600
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=900
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
# Leave SMTP_HOST empty only for local development. Verification codes will be logged instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=SHR Lost and Found
# Use TLS for port 587. Use SSL for port 465.
SMTP_USE_TLS=1
SMTP_USE_SSL=0
PUBLIC_API_BASE_URL=
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PATCH,DELETE,OPTIONS
API_DEBUG_LOGGING=1
REQUEST_DEBUG_LOGGING=1
REQUEST_DEBUG_PAYLOAD_MAX_CHARS=4000
# Set this to an Ollama URL reachable from the process or container.
# For Raspberry Pis, replace this with http://YOUR_MAC_LAN_IP:11434.
OLLAMA_HOST=http://host.docker.internal:11434
# Swarm containers need an Ollama URL reachable from inside the container.
# Docker Desktop on this Mac: SWARM_OLLAMA_HOST=http://host.docker.internal:11434
# Raspberry Pis calling Ollama on your Mac: SWARM_OLLAMA_HOST=http://<MAC_LAN_IP>:11434
SWARM_OLLAMA_HOST=
OLLAMA_MODEL=llama3:8b
OLLAMA_TEXT_MODEL=llama3:8b
OLLAMA_IMAGE_MODEL=llava
OLLAMA_TIMEOUT=120
AI_CHAT_MODEL=llama3:8b
